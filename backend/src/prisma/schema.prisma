// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

generator erd {
  provider = "prisma-erd-generator"
}

datasource db {
  provider = "postgresql"
}

enum ShopifyShopStatus {
  CONNECTED
  DISCONNECTED
  UNINSTALLED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum ShopMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
  DRAFT
  UNLISTED
}

enum InventoryPolicy {
  DENY
  CONTINUE
}

model User {
  id          String  @id @default(uuid()) @db.Uuid
  firstName   String?
  lastName    String?
  username    String? @unique
  clerkUserId String  @unique
  email       String  @unique
  imageUrl    String

  shopMemberships ShopMember[]
  oauthAttempts   ShopifyOAuthAttempt[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt
}

model Product {
  id               String @id @default(uuid()) @db.Uuid
  shopifyProductId String
  shopId           String @db.Uuid

  title           String
  handle          String
  description     String   @db.Text
  descriptionHtml String   @db.Text
  vendor          String
  productType     String
  tags            String[]

  status      ProductStatus
  createdAt   DateTime      @db.Timestamptz(3)
  updatedAt   DateTime      @db.Timestamptz(3)
  publishedAt DateTime?     @db.Timestamptz(3)

  totalInventory Int

  seoTitle       String?
  seoDescription String?

  featuredImageUrl     String?
  featuredImageAltText String?
  featuredImageWidth   Int?
  featuredImageHeight  Int?

  onlineStoreUrl        String?
  onlineStorePreviewUrl String?

  minVariantPrice    Decimal @db.Decimal(12, 2)
  minVariantCurrency String
  maxVariantPrice    Decimal @db.Decimal(12, 2)
  maxVariantCurrency String

  syncedAt        DateTime @default(now()) @db.Timestamptz(3)
  recordUpdatedAt DateTime @updatedAt @db.Timestamptz(3)

  shop          ShopifyShop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  variants      ProductVariant[]
  productReview ProductReview?

  @@unique([shopId, shopifyProductId])
  @@index([shopId, updatedAt])
}

model ProductReview {
  id        String @id @default(uuid()) @db.Uuid
  productId String @unique @db.Uuid

  seoTitle           String
  seoMetaDescription String @db.Text
  insights           Json

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model ProductVariant {
  id               String @id @default(uuid()) @db.Uuid
  shopifyVariantId String
  productId        String @db.Uuid

  title             String
  sku               String?
  barcode           String?
  price             Decimal         @db.Decimal(12, 2)
  compareAtPrice    Decimal?        @db.Decimal(12, 2)
  inventoryQuantity Int
  inventoryPolicy   InventoryPolicy

  selectedOptions Json

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, shopifyVariantId])
  @@index([productId])
}

model ShopifyShop {
  id         String @id @default(uuid()) @db.Uuid
  shopDomain String @unique

  status        ShopifyShopStatus @default(CONNECTED)
  grantedScopes String[]          @default([])

  accessTokenEncrypted  String? @db.Text
  refreshTokenEncrypted String? @db.Text

  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)

  connectedAt   DateTime? @db.Timestamptz(3)
  uninstalledAt DateTime? @db.Timestamptz(3)

  members  ShopMember[]
  products Product[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt
}

model ShopMember {
  id     String @id @default(uuid()) @db.Uuid
  shopId String @db.Uuid
  userId String @db.Uuid

  role ShopMemberRole @default(MEMBER)

  shop ShopifyShop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversations Conversation[]

  joinedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([shopId, userId])
}

model Conversation {
  id           String  @id @default(uuid()) @db.Uuid
  shopMemberId String  @db.Uuid
  title        String?

  member ShopMember @relation(fields: [shopMemberId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt

  @@index([shopMemberId, updatedAt])
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  content        String      @db.Text
  model          String?
  metadata       Json?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([conversationId, createdAt])
}

model ShopifyOAuthAttempt {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  stateHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
}
